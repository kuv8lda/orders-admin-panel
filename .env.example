# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Панель не читает .env сама: экспортируйте переменные в оболочке
# или передайте файл через `docker compose --env-file .env`.

# Подпись сессий и CSRF. Пусто: ключ создаётся и хранится в instance/secret_key.
# Для продакшена задайте длинную случайную строку:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Единственная учётная запись администратора.
ADMIN_USERNAME=admin
# При DEMO_MODE=0 пароль обязателен и не может быть Ltso2uJVANwzxlpwp-f6PvLB.
ADMIN_PASSWORD=

# 1 (по умолчанию) — публичное демо: логин и пароль показаны на странице входа.
# ADMIN_USERNAME и ADMIN_PASSWORD в демо игнорируются: используются публичные данные.
# Работает сброс демо-данных, при первом запуске создаются демо-заказы.
# 0 — закрытый режим, демо-данных нет, используются ADMIN_USERNAME и ADMIN_PASSWORD.
DEMO_MODE=1

# 1 — включить режим отладки Flask (только для локальной разработки).
FLASK_DEBUG=0

# Путь к файлу SQLite (относительный считается от папки проекта).
DATABASE_PATH=instance/app.db

# Токен интеграции с Telegram-ботом (не короче 32 символов).
# Пусто: эндпоинты /api/integrations/* выключены (отвечают 404).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_TOKEN=

# 1 — панель стоит за реверс-прокси: брать IP клиента из X-Forwarded-For
# (нужно для ограничения попыток входа). Включайте только за прокси.
TRUST_PROXY=0

# По умолчанию: 0 в демо (локальный HTTP), 1 в закрытом режиме (HTTPS).
# Для HTTPS можно явно задать COOKIE_SECURE=1; для локального HTTP — 0.
# COOKIE_SECURE=1

# Уровень логов: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Общий Bearer-токен доверенных сервисов: бот и парсер цен (минимум 32 символа).
# Пусто: /api/integrations/* и POST /api/competitor/prices отвечают 404.
PANEL_API_KEY=

# Push-адрес бота для версии каталога. Задаются только вместе; оба пустые — push выключен.
# Бот принимает POST JSON {"catalog":[...],"version":N} и Bearer-токен.
BOT_CATALOG_PUSH_URL=
BOT_CATALOG_PUSH_TOKEN=

# Панель загружает каталог сама при обновлении раздела «Конкуренты».
# Необязательный отдельный парсер: python scripts/competitor_parser.py
# Для парсера ключ берётся из PANEL_API_KEY выше; сайту конкурента он не передаётся.
COMPETITOR_SOURCE_URL=http://127.0.0.1:5001
PANEL_URL=http://127.0.0.1:5000
